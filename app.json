{
  "expo": {
    "name": "Succedo",
    "slug": "succedo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1815",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.razlow.succedo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12151F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.razlow.succedo",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#12151F",
          "resizeMode": "contain"
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Succedo uses your photos so you can pick a profile picture. It stays on your phone.",
          "cameraPermission": "Succedo uses the camera so you can take a profile picture. It stays on your phone.",
          "microphonePermission": false
        }
      ]
    ],
    "owner": "razlow",
    "extra": {
      "eas": {
        "projectId": "8f8e5d53-63b6-44d3-818b-cbd554bf14d6"
      }
    }
  }
}
